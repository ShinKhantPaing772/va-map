{
  "name": "czvg-live-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev:cloudflare": "npx wrangler pages dev public --compatibility-date=2026-06-30",
    "deploy:cloudflare": "npx wrangler pages deploy public",
    "check": "node --check server.mjs && node --check public/app.js && node --check 'functions/ifapi/[[path]].js'"
  }
}
